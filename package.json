{
  "name": "skillbridge-ui",
  "version": "1.0.0",
  "description": "Interfaz Tailwind basada en TailAdmin para SkillBridge AI",
  "scripts": {
    "start": "npm run dev:css",
    "build": "npm run build:css",
    "sort": "prettier --write src/main/resources/templates",
    "build:css": "tailwindcss -i ./src/main/resources/static/css/tailadmin.input.css -o ./src/main/resources/static/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i ./src/main/resources/static/css/tailadmin.input.css -o ./src/main/resources/static/css/tailwind.css --watch"
  },
  "keywords": ["spring-boot", "tailwindcss", "tailadmin"],
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "^0.5.9",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  }
}
