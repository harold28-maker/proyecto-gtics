# Copia este archivo como .env para desarrollo local.
# En AWS configura estas claves como variables o secretos; no subas .env.
SPRING_DATASOURCE_URL=jdbc:mysql://database-1.cvrl28ymltsm.us-east-1.rds.amazonaws.com:3306/skillbridge_ai?serverTimezone=America/Lima&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=reemplazar_con_password_de_rds
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
JPA_SHOW_SQL=false

PORT=8080
UPLOAD_DIR=uploads

GEMINI_API_KEY=reemplazar_con_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=700

# Solo son necesarias para las consultas reales de DNI.
VERIFICAID_TOKEN=reemplazar_con_token
VERIFICAID_URL=https://sandbox-api.verifica.id/v2/consulta/personas

# Docker Compose de desarrollo
MYSQL_ROOT_PASSWORD=reemplazar_con_password_local
# Para usar la guía local: SKILLBRIDGE_CHATBOT_PROVIDER=local y SPRING_AI_MODEL_CHAT=none.
